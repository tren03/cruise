{
    "manifest_version": 3,
    "name": "cruise",
    "version": "1.0",
    "description": "Fuzzy-find open tabs in Chrome",
    "background": {
        "service_worker": "./dist/service-worker.js"
    },
    "action": {
        "default_popup": "./dist/popup.html",
        "default_title": "cruise"
    },
    "permissions": ["tabs", "history", "topSites", "bookmarks"],
    "commands": {
        "toggle-tabs": {
            "suggested_key": {
                "default": "Alt+U"
            },
            "description": "Toggle tabs"
        },
        "_execute_action": {
            "suggested_key": {
                "default": "Alt+Y"
            },
            "description": "Open cruise dialog"
        }
    }
}
